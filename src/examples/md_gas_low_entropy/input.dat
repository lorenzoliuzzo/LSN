# Ex 04.2: gas started from an fcc crystal in half of the box with delta-distributed speeds.
SIMULATION_TYPE  0
PRIMES_FILE      ../Primes
SEED_FILE        ../seed.in
TEMP             2.0
NPART            108
RHO              0.05
R_CUT            5.0
DELTA            0.001
NBLOCKS          50
NSTEPS           1000
INIT_LATTICE     FCC_HALF
INIT_VELOCITIES  DELTA
POFV_BINS        50
PRINT_INSTANT    1
ENDINPUT
